# Supabase Connection Settings
# Copy this file to .env.local and fill in values for EITHER Local Supabase OR Hosted Supabase Cloud.
#
# Option A — Local Supabase (Docker + Supabase CLI):
#   1. Run `npm run db:start` (or `npx supabase start`)
#   2. Copy the Project URL (http://127.0.0.1:54321) and Publishable key printed in the output
#      (or inspect them anytime with `npm run db:status`)
#
# Option B — Hosted Supabase Cloud:
#   Get these values from Project Settings -> API:
#   https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
